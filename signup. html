<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Create Account | Arrow Trade</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<style>
*{box-sizing:border-box}
body{
 margin:0;min-height:100vh;display:flex;align-items:center;
 justify-content:center;background:#f8f8f6;
 font-family:Arial,sans-serif;color:#14243b;padding:20px
}
.box{
 width:100%;max-width:430px;background:white;padding:38px;
 border:1px solid #e8e5dc;border-radius:16px;
 box-shadow:0 15px 45px rgba(0,0,0,.06)
}
.logo{text-align:center;font-size:27px;font-weight:bold;letter-spacing:2px}
.logo span{color:#b99a58}
h2{text-align:center;margin:30px 0 8px}
.sub{text-align:center;color:#777;font-size:14px;margin-bottom:28px}
label{font-size:13px;font-weight:bold;display:block;margin:17px 0 8px}
input{
 width:100%;padding:14px;border:1px solid #ddd;
 border-radius:8px;font-size:15px;outline:none
}
input:focus{border-color:#b99a58}
button{
 width:100%;padding:15px;margin-top:24px;border:0;
 border-radius:8px;background:#14243b;color:white;
 font-size:15px;font-weight:bold;cursor:pointer
}
button:disabled{opacity:.6}
#message{text-align:center;font-size:13px;margin-top:16px;line-height:1.6}
.bottom{text-align:center;margin-top:22px;font-size:14px;color:#777}
a{color:#a48645;text-decoration:none}
</style>
</head>

<body>
<div class="box">

 <div class="logo">ARROW <span>TRADE</span></div>

 <h2>Create Account</h2>
 <p class="sub">Join Arrow Trade today</p>

 <form id="signupForm">

  <label>Full Name</label>
  <input type="text" id="name" placeholder="Enter your full name" required>

  <label>Email Address</label>
  <input type="email" id="email" placeholder="Enter your email" required>

  <label>Password</label>
  <input type="password" id="password" placeholder="Minimum 6 characters" minlength="6" required>

  <label>Confirm Password</label>
  <input type="password" id="confirmPassword" placeholder="Confirm your password" required>

  <button type="submit" id="signupBtn">CREATE ACCOUNT</button>

 </form>

 <div id="message"></div>

 <div class="bottom">
  Already have an account? <a href="login.html">Login</a>
  <br><br>
  <a href="index.html">Back to Home</a>
 </div>

</div>

<script>
const SUPABASE_URL = "https://sofargknzehbqkdlyywx.supabase.co";
const SUPABASE_KEY = "sb_publishable_7In44w5vW2bEXL6f1PDNOw_vwva-09m";

const db = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

document.getElementById("signupForm").addEventListener("submit", async function(e){

 e.preventDefault();

 const btn = document.getElementById("signupBtn");
 const message = document.getElementById("message");

 const name = document.getElementById("name").value.trim();
 const email = document.getElementById("email").value.trim();
 const password = document.getElementById("password").value;
 const confirmPassword = document.getElementById("confirmPassword").value;

 if(password !== confirmPassword){
  message.style.color = "red";
  message.textContent = "Passwords do not match.";
  return;
 }

 btn.disabled = true;
 btn.textContent = "CREATING ACCOUNT...";
 message.textContent = "";

 try{

  const {data,error} = await db.auth.signUp({
   email: email,
   password: password,
   options:{
    data:{
     full_name: name
    }
   }
  });

  if(error) throw error;

  message.style.color = "green";

  if(data.session){
   message.textContent = "Account created successfully! Redirecting to login...";
  }else{
   message.textContent = "Account created! Please verify your email, then login.";
  }

  document.getElementById("signupForm").reset();

  setTimeout(()=>{
   window.location.href = "login.html";
  },2500);

 }catch(error){

  message.style.color = "red";
  message.textContent = error.message || "Signup failed.";

  btn.disabled = false;
  btn.textContent = "CREATE ACCOUNT";

 }

});
</script>

</body>
</html>
